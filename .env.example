DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/csf-cms
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE

# Required on Vercel; omit locally to keep using public/media.
# Use a separate Blob store and token for Preview and Production.
# BLOB_READ_WRITE_TOKEN=
# BLOB_PUBLIC_URL=https://YOUR_STORE.public.blob.vercel-storage.com

# Optional absolute directory for persistent uploads (e.g. /data/media in Kubernetes).
# Leave unset locally to use public/media. Files are served through /api/media/file/.
# MEDIA_UPLOAD_DIR=/data/media

# SMTP (SMTP_SECURE=true is normally used with port 465; false with port 587)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM_ADDRESS=info@csf.cz
SMTP_FROM_NAME=CSF
SMTP_SKIP_VERIFY=false
